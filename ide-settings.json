{
  "editor.fontFamily": "'JetBrains Mono', Consolas, Menlo, monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "terminal.integrated.fontFamily": "'JetBrains Mono', Consolas, Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "animations.Enabled": true,
  "animations.UseCursorColorForCursorAnimation": true,
  "animations.Focus-Dimming-Mode": "Full Window"
}
